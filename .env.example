# App
APP_URL=https://artist.example.com
# Personal blog + invite-only private reading area
PERSONAL_BLOG_MODE=false
BLOG_LOCALE=zh
APP_NAME=Artist Member Site
NODE_ENV=production
# Informational only; auth and file rate limits are currently process-local.
APP_INSTANCE_COUNT=1

# Security
# "auto" enforces CSP unless an unmigrated legacy custom footer is present (Report-Only until migrated).
# "report-only" observes without blocking; "enforce" always enforces CSP.
SECURITY_CSP_MODE=auto
# Enable only when served exclusively over HTTPS (does not include preload).
SECURITY_HSTS_ENABLED=false
# Docker Compose auto-generates a persistent secret at /app/secrets/session-secret on first start.
# Non-Compose production deployments must set SESSION_SECRET or SESSION_SECRET_FILE (min 32 chars).
# Generate with: openssl rand -base64 32
# SESSION_SECRET=
# SESSION_SECRET_FILE=/app/secrets/session-secret

# Cloudflare Turnstile (optional bot protection for email login-code requests)
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Root key for encrypted admin settings.
# Docker Compose auto-generates and persists this key at CONFIG_ENCRYPTION_KEY_FILE; back it up when migrating.
CONFIG_ENCRYPTION_KEY=
CONFIG_ENCRYPTION_KEY_FILE=/app/secrets/config-encryption-key

# Database
DATABASE_URL=postgresql://artist:artist_password@postgres:5432/artist_member

# Migration runtime
MIGRATE_MAX_ATTEMPTS=30
# MIGRATIONS_FOLDER=/app/src/db/migrations

# Mail (fallback defaults; values configured in Admin Settings take precedence)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Artist Site <no-reply@example.com>"
# Retry interval (1-1440 min) and max age (1-168 h) for deferred transactional emails.
EMAIL_RETRY_RECHECK_MINUTES=15
EMAIL_DELIVERY_MAX_AGE_HOURS=24

# Durable task queue pacing (concurrency 1-4; per-batch quotas 0-20 within TASK_BATCH_SIZE=20)
TASK_DISPATCH_CONCURRENCY=4
TASK_TRANSACTIONAL_RESERVED_PER_BATCH=8
TASK_NOTIFICATION_MIN_PER_BATCH=2
TASK_NOTIFICATION_STALE_RECLAIM_MAX_PER_BATCH=2
TASK_MAINTENANCE_MAX_PER_BATCH=2
# Magic Link v2 intake rollout gate (see docs/deployment/magic-link-v2-rollout.md).
MAGIC_LINK_INTAKE_ENABLED=false
# Keep >=1 even during rollback drain.
TASK_AUTH_INTAKE_MAX_PER_BATCH=4
# Reservation duration must be >= MAGIC_LINK_DELIVERY_MAX_TOTAL_SECONDS.
MAGIC_LINK_DELIVERY_RESERVATION_SECONDS=120
MAGIC_LINK_DELIVERY_MAX_TOTAL_SECONDS=60
MAGIC_LINK_REQUEST_MAX_AGE_MINUTES=30
MAGIC_LINK_PENDING_CLEANUP_MIN_AGE_MINUTES=30
MAGIC_LINK_REQUEST_RETENTION_MINUTES=1440
MAGIC_LINK_STUCK_FENCE_ALERT_INTERVAL_SECONDS=300
MAGIC_LINK_STUCK_FENCE_MAX_PER_SWEEP=20

# New-post email notifications (opt-in defaults off; separate from transactional mail)
NOTIFICATION_EMAIL_DAILY_BUDGET=500
NOTIFICATION_EMAIL_PACING_PER_MINUTE=30
NOTIFICATION_CAMPAIGN_EXPANSION_BATCH_SIZE=500
NOTIFICATION_DELIVERY_MAX_AGE_HOURS=168
NOTIFICATION_UNSUBSCRIBE_TOKEN_MAX_AGE_DAYS=180

# Notification and Magic Link signing keys (Docker Compose auto-provisions *_FILE on first start;
# direct *_SECRET values take precedence over *_SECRET_FILE).
NOTIFICATION_UNSUBSCRIBE_KEY_ID=current
# NOTIFICATION_UNSUBSCRIBE_SECRET=
NOTIFICATION_UNSUBSCRIBE_SECRET_FILE=/app/secrets/notification-unsubscribe-secret
# NOTIFICATION_UNSUBSCRIBE_PREVIOUS_KEY_ID=previous
# NOTIFICATION_UNSUBSCRIBE_PREVIOUS_SECRET=
# NOTIFICATION_UNSUBSCRIBE_PREVIOUS_SECRET_FILE=/app/secrets/notification-unsubscribe-previous-secret

NOTIFICATION_SUPPRESSION_DIGEST_KEY_ID=current
# NOTIFICATION_SUPPRESSION_DIGEST_SECRET=
NOTIFICATION_SUPPRESSION_DIGEST_SECRET_FILE=/app/secrets/notification-suppression-digest-secret
# NOTIFICATION_SUPPRESSION_DIGEST_PREVIOUS_KEY_ID=previous
# NOTIFICATION_SUPPRESSION_DIGEST_PREVIOUS_SECRET=
# NOTIFICATION_SUPPRESSION_DIGEST_PREVIOUS_SECRET_FILE=/app/secrets/notification-suppression-digest-previous-secret

# Leaving Magic Link keys unset hides the login-link option on the login page.
MAGIC_LINK_KEY_ID=current
# MAGIC_LINK_SECRET=
MAGIC_LINK_SECRET_FILE=/app/secrets/magic-link-secret
# MAGIC_LINK_PREVIOUS_KEY_ID=previous
# MAGIC_LINK_PREVIOUS_SECRET=
# MAGIC_LINK_PREVIOUS_SECRET_FILE=/app/secrets/magic-link-previous-secret

# Storage (UPLOAD_DIR is deployment-only and not editable in Admin Settings)
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads

# S3-compatible Storage (use S3_REGION=auto for Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Request body and upload limits
REQUEST_JSON_MAX_BYTES=65536
STRIPE_WEBHOOK_MAX_BYTES=262144
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=60
SUBSCRIPTION_REMINDER_LEAD_DAYS=7
IMAGE_MAX_FRAMES=300
IMAGE_MAX_TOTAL_PIXELS=300000000
MAX_UPLOAD_SIZE_MB=500
PAYMENT_PROOF_MAX_SIZE_MB=10
PAYMENT_PROOF_RETENTION_DAYS=30
PAYMENT_PROOF_MAX_PER_DAY=20
PROOF_UPLOAD_RESERVATION_TTL_MINUTES=5
# Grace period (hours) before unreferenced inline post images are cleaned up.
INLINE_UPLOAD_GRACE_PERIOD_HOURS=24

# Inline video playback and file request rate limits
PUBLIC_VIDEO_SIGNED_URL_TTL_SECONDS=21600
FILE_PREAUTH_RATE_LIMIT_MAX=1200
FILE_PREAUTH_UNRESOLVED_RATE_LIMIT_MAX=20000
FILE_PREAUTH_RATE_LIMIT_WINDOW_MS=600000
VIDEO_RANGE_RATE_LIMIT_MAX=600
VIDEO_UNRESOLVED_RATE_LIMIT_MAX=10000
VIDEO_RANGE_RATE_LIMIT_WINDOW_MS=600000
DOWNLOAD_UNRESOLVED_RATE_LIMIT_MAX=2000

# Auth rate limits and login-code policy
# New login codes are fixed at 6 decimal digits; LOGIN_CODE_* remain parseable for compatibility.
LOGIN_CODE_LENGTH=6
LOGIN_CODE_ALPHABET=decimal
ADMIN_LOGIN_RATE_MAX=10
ADMIN_LOGIN_UNRESOLVED_RATE_MAX=100
ADMIN_LOGIN_RATE_WINDOW_MS=600000
VERIFY_CODE_IP_RATE_MAX=30
VERIFY_CODE_UNRESOLVED_RATE_MAX=300
VERIFY_CODE_EMAIL_IP_RATE_MAX=10
VERIFY_CODE_RATE_WINDOW_MS=600000
REQUEST_CODE_IP_RATE_MAX=20
REQUEST_CODE_EMAIL_IP_RATE_MAX=5
REQUEST_CODE_UNRESOLVED_RATE_MAX=100
REQUEST_CODE_RATE_WINDOW_MS=3600000
REQUEST_CODE_SEND_DEDUPE_SECONDS=60
OAUTH_START_IP_RATE_MAX=20
OAUTH_START_UNRESOLVED_RATE_MAX=100
OAUTH_START_RATE_WINDOW_MS=600000

# Reverse Proxy / Client IP
# Default 0 trusts no forwarding headers. Set TRUSTED_PROXY_HOPS to the number of trusted proxy hops,
# or use TRUSTED_PROXY_HEADER=cf-connecting-ip for Cloudflare Tunnel (do not expose port 3000 publicly).
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_HEADER=x-forwarded-for
# Keep false for public deployments; base docker-compose.yml enables direct LAN access unless overridden below.
AUTH_ALLOW_UNRESOLVED_CLIENT_IP=false
DIRECT_COMPOSE_AUTH_ALLOW_UNRESOLVED_CLIENT_IP=

# Reverse Proxy (Caddy overlay: docker-compose.caddy.yml)
APP_DOMAIN=artist.example.com

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
